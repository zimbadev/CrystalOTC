+// Open models are indexed per context: the same model name can be open in several contexts at
+// once, and closing it in one of them must not find (and tear down) the model of another.
+static void PushDataModelKey(lua_State* L, Context* context, int name_index)
+{
+	lua_pushfstring(L, "%p:%s", (void*)context, lua_tostring(L, name_index));
+}
