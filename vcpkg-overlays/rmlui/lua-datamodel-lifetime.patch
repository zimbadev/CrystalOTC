@@ -524,6 +528,15 @@ static struct TableProxy* NewTableProxy(struct LuaDataModel* model, int key_ref)
 	}
 	lua_setmetatable(L, -2);
 
+	// The proxy points at its model, which is a userdata owned by the garbage collector. Once the
+	// model is closed nothing else references that userdata, so it could be collected before the
+	// proxy is finalized and TableProxyGc would read freed memory. Reference it from the proxy.
+	lua_newtable(L);
+	PushValue(model, model->model_ref);
+	lua_rawseti(L, -2, 1);
+	lua_setuservalue(L, -2);
+	// -1 = proxy
+
 	return proxy;
 }
 
